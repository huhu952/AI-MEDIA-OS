{
  "router": {
    "description": "AI-MEDIA-OS 统一 Provider/Model Router 配置示例。所有 endpoint/env_key 均为占位符，真实值放环境变量。",
    "default_text_model": "openai-chat",
    "default_image_model": "openai-image",
    "default_video_model": "openai-video",
    "default_tts_model": "openai-tts",
    "default_stt_model": "local-whisper",
    "providers": {
      "openai-chat": {
        "name": "OpenAI 对话",
        "type": "chat",
        "provider": "openai",
        "endpoint": "https://api.openai.com/v1",
        "env_key": "OPENAI_API_KEY",
        "model": "gpt-5.6",
        "fallback": ["openrouter-chat"]
      },
      "openai-image": {
        "name": "OpenAI 图像生成",
        "type": "image",
        "provider": "openai",
        "endpoint": "https://api.openai.com/v1",
        "env_key": "OPENAI_API_KEY",
        "model": "gpt-image-2"
      },
      "openai-video": {
        "name": "OpenAI 视频生成",
        "type": "video",
        "provider": "openai",
        "endpoint": "https://api.openai.com/v1",
        "env_key": "OPENAI_API_KEY",
        "model": "sora-2"
      },
      "openai-tts": {
        "name": "OpenAI TTS",
        "type": "tts",
        "provider": "openai",
        "endpoint": "https://api.openai.com/v1",
        "env_key": "OPENAI_API_KEY",
        "model": "gpt-4o-mini-tts"
      },
      "local-whisper": {
        "name": "本地 Whisper (faster-whisper)",
        "type": "stt",
        "provider": "local",
        "endpoint": "local",
        "env_key": "WHISPER_MODEL",
        "model": "base"
      },
      "deepseek-chat": {
        "name": "DeepSeek 对话",
        "type": "chat",
        "provider": "deepseek",
        "endpoint": "https://api.deepseek.com",
        "env_key": "DEEPSEEK_API_KEY",
        "model": "deepseek-chat"
      },
      "dashscope-image": {
        "name": "通义万相图像",
        "type": "image",
        "provider": "dashscope",
        "endpoint": "https://dashscope.aliyuncs.com/compatible-mode/v1",
        "env_key": "DASHSCOPE_API_KEY",
        "model": "wanx2.1"
      },
      "openrouter-chat": {
        "name": "OpenRouter 对话（多模型回退）",
        "type": "chat",
        "provider": "openrouter",
        "endpoint": "https://openrouter.ai/api/v1",
        "env_key": "OPENROUTER_API_KEY",
        "model": "auto"
      },
      "search-service": {
        "name": "搜索服务",
        "type": "search",
        "provider": "search",
        "endpoint": "https://your-search-endpoint.example",
        "env_key": "SEARCH_API_KEY",
        "model": null
      },
      "comfyui-cloud": {
        "name": "ComfyUI（云端待定）",
        "type": "image",
        "provider": "comfyui",
        "endpoint": "https://your-comfyui-endpoint.example",
        "env_key": "COMFYUI_TOKEN",
        "model": "workflow-preset"
      }
    }
  }
}
