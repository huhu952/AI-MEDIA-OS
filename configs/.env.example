# AI-MEDIA-OS 环境变量模板
# 复制为 .env（或按平台设置系统环境变量）后填入真实值。
# 严禁把真实值提交到 Git；.env 已被 .gitignore 排除。

# --- OpenAI / 对话与生成 ---
# OpenAI API Key（对话、图像、视频等官方 API）
OPENAI_API_KEY=your-openai-key-here

# 图像生成模型（可选覆盖，默认 gpt-image-2）
IMAGE_MODEL=gpt-image-2

# 视频生成模型（可选覆盖，默认 sora-2）
VIDEO_MODEL=sora-2

# --- 语音 ---
# faster-whisper 模型下载镜像（国内推荐）
HF_ENDPOINT=https://hf-mirror.com
# 禁用 HuggingFace Xet 存储（hf-mirror 需要）
HF_HUB_DISABLE_XET=1
# 语音模型大小：tiny/base/small（生产建议 base 或 small）
WHISPER_MODEL=base

# --- 第三方/本地模型（按需启用） ---
DEEPSEEK_API_KEY=your-deepseek-key-here
DASHSCOPE_API_KEY=your-dashscope-key-here
ZHIPU_API_KEY=your-zhipu-key-here
MOONSHOT_API_KEY=your-moonshot-key-here
OPENROUTER_API_KEY=your-openrouter-key-here

# --- 浏览器自动化 ---
# Playwright 浏览器二进制下载镜像（国内推荐）
PLAYWRIGHT_DOWNLOAD_HOST=https://npmmirror.com/mirrors/playwright/
# Playwright 浏览器存放目录（项目本地）
PLAYWRIGHT_BROWSERS_PATH=C:\Users\administered\Documents\Codex\AI-MEDIA-OS\tools\browser\.browsers

# --- 搜索服务（按需） ---
SEARCH_API_KEY=your-search-api-key-here

# --- 云端生图/视频（按需，如 Replicate/fal/火山） ---
REPLICATE_API_TOKEN=your-replicate-token-here
FAL_KEY=your-fal-key-here

# --- 代理（如需要梯子） ---
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
