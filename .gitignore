# Secrets — never commit
.env
*.env
!*.env.example
configs/*.local.*
**/secrets/
*.pem
*.key
*cookie*
*token*

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Node
node_modules/
.browsers/

# OS
.DS_Store
Thumbs.db
desktop.ini

# Project runtime
temp/
logs/
outputs/media/
outputs/renders/
outputs/raw/
database/*.db
database/*.sqlite*

# Large media (keep layouts/prompts in git, not binaries)
*.mp4
*.mov
*.mkv
*.avi
*.wav
*.flac
*.mp3
*.png
*.jpg
*.jpeg
*.webp
*.gif
!**/*.gitkeep

# 例外：角色/场景参考图等小型设计资产允许入库（管线一致性关键资产）
!assets/images/character_refs/
!assets/images/character_refs/**/*.png
!assets/images/character_refs/**/*.jpg
!assets/images/character_refs/**/*.jpeg
!assets/images/character_refs/**/*.webp
!assets/images/scene_refs/
!assets/images/scene_refs/**/*.png
!assets/images/scene_refs/**/*.jpg
!assets/images/scene_refs/**/*.jpeg
!assets/images/scene_refs/**/*.webp

# Codex / tooling
.codex/
.agents/
.idea/
.vscode/
