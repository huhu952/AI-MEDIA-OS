# Secrets — never commit
.env
*.env
!*.env.example
configs/*.local.*
**/secrets/
*.pem
*.key
*cookie*
*token*

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Node
node_modules/

# OS
.DS_Store
Thumbs.db
desktop.ini

# Project runtime
temp/
logs/
outputs/media/
outputs/renders/
outputs/raw/
database/*.db
database/*.sqlite*

# Large media (keep layouts/prompts in git, not binaries)
*.mp4
*.mov
*.mkv
*.avi
*.wav
*.flac
*.mp3
*.png
*.jpg
*.jpeg
*.webp
*.gif
!**/*.gitkeep

# Codex / tooling
.codex/
.agents/
.idea/
.vscode/
